# Flutter/Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.iml
*.ipr
*.iws

# Generated code — run `dart run build_runner build` after cloning
**/*.g.dart
**/*.freezed.dart

# Localization — run `flutter gen-l10n` after cloning (or `flutter pub get`,
# which triggers it automatically since pubspec.yaml sets `generate: true`).
# The .arb sources under lib/l10n/ are the real, tracked, hand-edited files.
lib/l10n/app_localizations.dart
lib/l10n/app_localizations_*.dart

# Firebase secrets — never commit
**/google-services.json
**/GoogleService-Info.plist
lib/core/config/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
firebase-debug.log
.firebase/

# IDE
.idea/
.vscode/
*.swp
.DS_Store

# Android
android/**/gradle-wrapper.jar
android/.gradle/
android/captures/
android/gradlew
android/gradlew.bat
android/local.properties
**/android/**/GeneratedPluginRegistrant.java

# iOS
ios/**/*.mode1v3
ios/**/*.mode2v3
ios/**/*.moved-aside
ios/**/*.pbxuser
ios/**/*.perspectivev3
ios/**/Pods/
ios/**/.symlinks/
ios/**/Flutter/Flutter.framework
ios/**/Flutter/Flutter.podspec
ios/Flutter/flutter_export_environment.sh
ios/ServiceDefinitions.json

# Coverage
coverage/

# Env
.env
.env.*
.env.local
.env.*.local

# Google Maps API key — never commit, see web/maps_config.js.example
web/maps_config.js

# Platform runner folders — regenerate locally, do not commit.
# Run: flutter create . --platforms=android,ios,macos
/android/
/ios/
/macos/

# Claude Code / Ruflo — editor tooling and session state, local only.
# Everyone's install differs (plugins, hooks, machine-specific tokens), so
# none of this is shared via git. CLAUDE.md (the project-instructions file)
# is intentionally NOT listed here — that one is meant to be checked in.
.claude/
.claude-flow/
.swarm/
Claude outputs/
session-history/
