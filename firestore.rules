rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // users/{userId} — AppUser. Any signed-in user can read (needed for
    // matching/profile display); only the owner or an admin can write.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if false;
    }

    // verification_requests/{requestId} — VerificationRequest. Owner can
    // create/read their own; only an admin can review (approve/reject).
    match /verification_requests/{requestId} {
      allow create: if isOwner(request.resource.data.userId);
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // trust_scores/{userId} — TrustScore. Readable by any signed-in user
    // (shown on profiles/match cards); written only by a Cloud Function
    // (Admin SDK bypasses these rules) after session completion/feedback.
    match /trust_scores/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // profiles/{userId} — UserProfile. Readable by any signed-in user
    // (needed for matching/search); only the owner can write.
    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // sessions/{sessionId} — Session. Only the two participants
    // (requester/volunteer) can read, create, or update.
    match /sessions/{sessionId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.requesterId ||
         request.auth.uid == resource.data.volunteerId);
      allow create: if isSignedIn() &&
        (request.auth.uid == request.resource.data.requesterId ||
         request.auth.uid == request.resource.data.volunteerId);
      allow update: if isSignedIn() &&
        (request.auth.uid == resource.data.requesterId ||
         request.auth.uid == resource.data.volunteerId);
      allow delete: if false;
    }

    // session_feedback/{feedbackId} — SessionFeedback. Only a participant
    // of the referenced session can create feedback for it; only
    // participants of that session can read it.
    match /session_feedback/{feedbackId} {
      function session() {
        return get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data;
      }
      function existingSession() {
        return get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)).data;
      }

      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.raterId &&
        (request.auth.uid == session().requesterId ||
         request.auth.uid == session().volunteerId);
      allow read: if isSignedIn() &&
        (request.auth.uid == existingSession().requesterId ||
         request.auth.uid == existingSession().volunteerId);
      allow update: if false;
      allow delete: if false;
    }

    // conversations/{conversationId} — Conversation. Only the two
    // participants can read it or write to it (create requires the creator
    // to be one of the exactly-2 participantIds; update covers the
    // lastMessageText/lastMessageAt bump on send).
    match /conversations/{conversationId} {
      allow read: if isSignedIn() &&
        request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.participantIds.size() == 2;
      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.participantIds;
      allow delete: if false;

      // conversations/{conversationId}/messages/{messageId} — ChatMessage.
      // Only a participant of the parent conversation (looked up via
      // get()) can read or create messages; messages are immutable once
      // written.
      match /messages/{messageId} {
        function conversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        allow read: if isSignedIn() &&
          request.auth.uid in conversation().participantIds;
        allow create: if isSignedIn() &&
          request.auth.uid in conversation().participantIds &&
          request.auth.uid == request.resource.data.senderId;
        allow update: if false;
        allow delete: if false;
      }
    }

    // notifications/{notificationId} — AppNotification. The recipient can
    // read and mark their own as read. Creation is allowed broadly because
    // the writer is typically a different signed-in user than the
    // recipient (e.g. the other session participant, or an admin
    // reviewing a verification request), so it can't be restricted to
    // isOwner(userId). Only the isRead flip is permitted on update, and
    // only by the recipient.
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isSignedIn();
      allow update: if isOwner(resource.data.userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if false;
    }

    // community_posts/{postId} — CommunityPost. Any signed-in user can
    // read the feed; only the author can create their own post; only the
    // author can delete it. Posts are immutable — no update.
    match /community_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isOwner(request.resource.data.authorId);
      allow delete: if isOwner(resource.data.authorId);
      allow update: if false;
    }
  }
}
